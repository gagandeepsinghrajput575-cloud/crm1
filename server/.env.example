# ---------------------------------------------------------------- runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# ---------------------------------------------------------------- static UI
# Serve index.html + js/ from this server, so the UI and the API share one
# origin. This is the default and the recommended setup: no CORS
# configuration, and no API discovery for the browser to get wrong.
# Set to an empty value to run the API alone.
STATIC_DIR=..

# Comma-separated CORS allow-list. Only needed if you serve the UI from a
# different origin (a Vite dev server, say). Leave empty to disable CORS
# entirely, which is the safe default.
CORS_ORIGIN=

# ---------------------------------------------------------------- database
# Leave DATABASE_URL empty to run on the embedded PGlite database (zero
# install, ideal for local dev and the test suite). Set it to a real
# postgres:// URL for production.
DATABASE_URL=
# DATABASE_URL=postgresql://dialflow:dialflow@localhost:5432/dialflow?schema=public

# ---------------------------------------------------------------- auth
# Required. The server refuses to boot without it. Generate one with:
#   node -e "console.log('df_' + require('crypto').randomBytes(32).toString('base64url'))"
# Store only the SHA-256 of this value in the database; it is never persisted.
API_KEY=

# Optional second key for local development, so you can rotate without downtime.
# API_KEY_PREVIOUS=

# ---------------------------------------------------------------- telephony
# `mock` is fully deterministic and needs no credentials. Swap to `sonetel`
# once you have filled in the Sonetel credentials below.
TELEPHONY_PROVIDER=mock

# Sonetel OAuth (only read when TELEPHONY_PROVIDER=sonetel)
SONETEL_BASE_URL=https://api.sonetel.com
SONETEL_CLIENT_ID=
SONETEL_CLIENT_SECRET=
SONETEL_USERNAME=
SONETEL_PASSWORD=
# Default caller ID presented on outbound PSTN legs.
SONETEL_CALLER_ID=

# ---------------------------------------------------------------- hardening
# Requests per window, per API key.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# Hard cap on CSV upload size in bytes (5 MB).
MAX_UPLOAD_BYTES=5242880
# Set to `true` in production to suppress the /docs UI and JSON schema.
DISABLE_DOCS=false
